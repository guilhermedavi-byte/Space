{
  "rewrites": [
    { "source": "/api/lesson-logs", "destination": "/api/schedule-events?resource=lesson-logs" },
    { "source": "/api/admin-alerts", "destination": "/api/schedule-events?resource=admin-alerts" },
    { "source": "/api/crm-test", "destination": "/api/growth-dashboard?api=crm-test" },
    { "source": "/api/growth-goals/current", "destination": "/api/growth-dashboard?api=growth-goals&mode=current" },
    { "source": "/api/growth-goals", "destination": "/api/growth-dashboard?api=growth-goals" },
    { "source": "/api/growth-metrics", "destination": "/api/growth-dashboard?api=growth-metrics" },
    { "source": "/api/growth-contratos", "destination": "/api/growth-dashboard?api=growth-contratos" },
    { "source": "/api/admin-sheets-metrics", "destination": "/api/growth-dashboard?api=admin-sheets-metrics" },
    { "source": "/api/zapsign-webhook", "destination": "/api/growth-dashboard?api=zapsign-webhook" },
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/financeiro", "destination": "/api/financeiro" },
    { "source": "/growth/dashboard", "destination": "/api/growth-dashboard" },
    { "source": "/growth/contratos", "destination": "/api/growth-dashboard?page=contracts" },
    { "source": "/aula/:id/encerramento", "destination": "/api/aula-encerramento?id=:id" },
    { "source": "/aula/:id", "destination": "/api/aula?id=:id" },
    { "source": "/app", "destination": "/api/app" },
    { "source": "/app/(.*)", "destination": "/api/app?path=$1" }
  ]
}

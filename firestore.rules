rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "admin"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "administrador"
        );
    }

    // Users (perfil/base de autenticação)
    // - Admin pode listar/ler/alterar qualquer usuário.
    // - Usuário autenticado pode ler seu próprio perfil (necessário para APIs como /api/schedule-events).
    match /users/{userId} {
      allow get, read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();

      // Admin > Alunos: arquivos do aluno (subcoleção)
      match /files/{fileId} {
        allow read: if request.auth != null && (isAdmin() || request.auth.uid == userId);
        allow write: if isAdmin();
      }
    }

    // Scheduling (REST APIs /api/schedule-events, etc.)
    match /aulas/{docId} {
      allow read: if request.auth != null
        && (
          isAdmin()
          || (
            (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "teacher"
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "professor"
            )
            && resource.data.professorId == request.auth.uid
          )
        );
      allow write: if isAdmin();
    }

    // Cadastros e operação pedagógica administrados dentro da plataforma.
    match /classes/{docId} {
      allow read, write: if isAdmin();
    }

    match /groups/{docId} {
      allow read, write: if isAdmin();
    }

    match /plans/{docId} {
      allow read, write: if isAdmin();
    }

    match /surveys/{docId} {
      allow read, write: if isAdmin();
    }

    match /pedagogicalFeedbacks/{docId} {
      allow read, write: if isAdmin();
    }

    match /teacherAlerts/{docId} {
      allow read, write: if isAdmin();
    }

    // Leads são gravados pela API autenticada com conta de serviço.
    match /leads/{docId} {
      allow read, write: if isAdmin();
    }

    // NOTE:
    // This repo does not deploy Firebase rules automatically.
    // Copy/paste the match below into your existing Firestore Rules in the Firebase Console,
    // merging it with your current rules.

    // Growth goals (monthly targets)
    match /growthGoals/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && isAdmin();
    }

    // Lesson logs (Controle Pedagógico)
    match /lessonLogs/{docId} {
      allow read: if request.auth != null
        && (
          isAdmin()
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "teacher"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "professor"
        );
      allow write: if request.auth != null
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "teacher"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "professor"
        )
        && request.resource.data.professorId == request.auth.uid;
    }

    // Admin alerts (ex: remarcação causada pelo professor)
    match /adminAlerts/{docId} {
      allow read: if request.auth != null
        && isAdmin();
      allow write: if request.auth != null
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "teacher"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "professor"
        )
        && request.resource.data.professorId == request.auth.uid;
    }

    // Onboarding (professores) - conteúdos e quizzes
    match /onboardingContents/{docId} {
      allow read: if request.auth != null
        && (
          isAdmin()
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "teacher"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "professor"
        );
      allow write: if request.auth != null
        && isAdmin();
    }

    match /onboardingQuizzes/{docId} {
      allow read: if request.auth != null
        && (
          isAdmin()
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "teacher"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "professor"
        );
      allow write: if request.auth != null
        && isAdmin();
    }

    // Onboarding (professores) - progresso e respostas
    match /teacherOnboardingProgress/{docId} {
      allow read: if request.auth != null
        && (
          isAdmin()
          || resource.data.teacherId == request.auth.uid
        );
      allow create, update: if request.auth != null
        && (
          isAdmin()
          || (
            (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "teacher"
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "professor"
            )
            && request.resource.data.teacherId == request.auth.uid
          )
        );
      allow delete: if request.auth != null
        && isAdmin();
    }

    match /teacherQuizSubmissions/{docId} {
      allow read: if request.auth != null
        && (
          isAdmin()
          || resource.data.teacherId == request.auth.uid
        );
      // Teacher can only create a new submission doc once (no edits).
      allow create: if request.auth != null
        && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "teacher"
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == "professor"
        )
        && request.resource.data.teacherId == request.auth.uid
        && !exists(/databases/$(database)/documents/teacherQuizSubmissions/$(docId));
      allow update, delete: if request.auth != null
        && isAdmin();
    }
  }
}

# Copy to an ignored private .env file. Values remain server-side.
# Existing runtime isolation also validates the staging Firebase configuration.
APP_ENV=staging
SPACE_APP_ENV=staging
SPACE_PUBLIC_BASE_URL=https://staging.example.com
SPACE_PRODUCTION_PUBLIC_BASE_URL=
FINANCE_SANDBOX_WEBHOOK_URL=https://staging.example.com/api/asaas-webhook
SPACE_AUTH_SECRET=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ENV_SCOPE=staging
SPACE_STAGING_SUPABASE_URL=
SPACE_PRODUCTION_SUPABASE_URL=
FINANCE_STAGING_PROJECT_REF=
# Requires an independently reviewed entry in config/finance-staging-targets.json.
# Set YES explicitly only for the reviewed apply operation. Empty fails closed.
FINANCE_STAGING_APPLY=
SPACE_PRODUCTION_FIREBASE_PROJECT_ID=plataforma-space
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_KEY_SCOPE=sandbox
ASAAS_WEBHOOK_TOKEN=
# Set after applying the migration and running `init --apply` against staging.
FINANCE_CONNECTION_ID=
# Keep disabled until schema + account identity + processor have been validated.
FINANCE_FOUNDATION_ENABLED=false
# If false, run process/drain explicitly. No automatic scheduler is installed.
FINANCE_WEBHOOK_PROCESS_INLINE=true

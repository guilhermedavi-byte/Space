# Template only. Copy outside Git with mode 0600; no implicit .env.local loading.
APP_ENV=staging
SPACE_APP_ENV=staging
SUPABASE_ENV_SCOPE=staging
SUPABASE_URL=
SPACE_STAGING_SUPABASE_URL=
SPACE_PRODUCTION_SUPABASE_URL=
ATTENDANCE_STAGING_PROJECT_REF=
SUPABASE_SERVICE_ROLE_KEY=
# Direct database URL, URL-encoded password, no query parameters; TLS is forced by runner.
ATTENDANCE_STAGING_DATABASE_URL=
ATTENDANCE_STAGING_CONFIRM=
# Keep the HTTP API disabled until Firebase/Vercel isolation is validated separately.
ATTENDANCE_FOUNDATION_ENABLED=false
